generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // o "mysql" / "sqlite" según tu caso
  url      = env("DATABASE_URL")
}

// Tabla de roles de usuario
model Role {
  id          Int      @id @default(autoincrement())
  name        String
}

// Tabla de clusters con la información del análisis HDBSCAN
model Cluster {
  id               Int      @id @default(autoincrement())
  perfilPromedio   String
  riesgo           String
  estrategiaMkt    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Tabla intermedia (rompe) entre usuarios y clusters
model UserCluster {
  id         Int      @id @default(autoincrement())
  userId     Int
  clusterId  Int
  assignedAt DateTime @default(now())
}